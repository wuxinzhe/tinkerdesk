{
  "name": "tinkerdesk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev:web": "vite --config vite.config.web.ts",
    "build:web": "vite build --config vite.config.web.ts",
    "dev:desktop": "electron-vite dev -- --remote-debugging-port=9222 --inspect=5858",
    "build:desktop": "electron-vite build",
    "preview:desktop": "electron-vite preview",
    "lint": "eslint src --ext .ts,.vue",
    "typecheck": "npm run typecheck:web && npm run typecheck:main",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck:main": "tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/genai": "^2.16.0",
    "cheerio": "^1.2.0",
    "electron-updater": "^6.8.9",
    "handlebars": "^4.7.9",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "naive-ui": "^2.41.0",
    "node-edge-tts": "^1.2.10",
    "openai": "^7.4.0",
    "pinia": "^3.0.2",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.14.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/eslint-config-typescript": "^14.9.0",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.3.2",
    "vue-tsc": "^2.2.8"
  }
}
