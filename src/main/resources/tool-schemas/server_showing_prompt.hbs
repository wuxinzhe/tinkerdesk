{
  "name": "server_showing_prompt",
  "description": "Manage the prompt module layout for your current session. Use `get_structure` to inspect the current module arrangement, `move` to reposition a module to a different region and order, and `reset` to restore the default arrangement. Each LLM call loads modules in region+order sequence.",
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": ["move", "get_structure", "reset"],
        "description": "Action to perform: 'move' adjusts one module's position, 'get_structure' returns the current layout of all modules, 'reset' clears all position overrides."
      },
      "module_id": {
        "type": "string",
        "description": "Required for 'move': the module identifier to reposition."
      },
      "region": {
        "type": "string",
        "enum": ["pre", "mid", "post"],
        "description": "Required for 'move': target region. 'pre' = start of prompt (highest attention), 'mid' = middle (reference data zone), 'post' = just before user message (execution instructions)."
      },
      "order": {
        "type": "integer",
        "description": "Required for 'move': sort order within the target region (0-based). Lower values appear first."
      },
      "reason": {
        "type": "string",
        "description": "Optional for 'move': why this change is being made, logged for analysis."
      }
    },
    "required": ["action"]
  },
  "toolType": "server",
  "emoji": "⚡"
}
