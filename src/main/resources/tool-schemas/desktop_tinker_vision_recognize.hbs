{
  "name": "desktop_tinker_vision_recognize",
  "description": "Analyze images using a multimodal vision model. Accepts one or more image URLs (http/https/data: base64) plus an optional text prompt/question. Returns the model's textual analysis of the image(s). Use this when the user asks about the content of an image, screenshot, or visual data. IMPORTANT: when the user sends an image attachment (their message contains text like '[Image attached at: media/xxx.jpg]'), pass that relative path (e.g. media/20260815_1325_86a3ed28.jpg) directly as image_url — the app resolves it to the local file automatically. Do NOT search the filesystem to locate the image; just call this tool with the path from the attachment.",
  "parameters": {
    "type": "object",
    "properties": {
      "image_url": {
        "type": "string",
        "description": "The image URL to analyze. Accepts http/https URLs, data: base64 data URLs, or the relative path from an image attachment message (e.g. media/xxx.jpg — the app resolves it automatically)."
      },
      "prompt": {
        "type": "string",
        "description": "Optional question or instruction about the image. Default: '描述这张图片'"
      }
    },
    "required": ["image_url"]
  },
  "toolType": "desktop",
  "emoji": "👁️",
  "supportsProvider": true
