{
  "name": "desktop_tinker_vision_recognize",
  "description": "Analyze images using a multimodal vision model. Accepts one or more image URLs/paths (up to 5) plus an optional text prompt/question. Returns the model's textual analysis of the image(s). Use this when the user asks about the content of an image, screenshot, or visual data. IMPORTANT: when the user sends image attachments (their message contains lines like '[Image attached at: media/xxx.jpg]'), pass those relative paths (e.g. media/20260815_1325_86a3ed28.jpg) as image_url — the app resolves them to local files automatically. Do NOT search the filesystem to locate the images; just call this tool with the paths from the attachments.",
  "parameters": {
    "type": "object",
    "properties": {
      "image_url": {
        "type": "array",
        "items": { "type": "string" },
        "maxItems": 5,
        "description": "Image URLs/paths to analyze (up to 5). Accepts http/https URLs, data: base64 data URLs, or relative paths from image attachment messages (e.g. media/xxx.jpg — the app resolves them automatically)."
      },
      "prompt": {
        "type": "string",
        "description": "Optional question or instruction about the image(s). Default: '描述这张图片'"
      }
    },
    "required": ["image_url"]
  },
  "toolType": "desktop",
  "emoji": "👁️",
  "supportsProvider": true
}