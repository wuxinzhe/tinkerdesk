{
  "name": "desktop_tinker_vision_recognize",
  "description": "Analyze images using a multimodal vision model. Accepts one or more image URLs/paths (up to 5) plus an optional text prompt/question. Returns the model's textual analysis of the image(s). Use this when the user asks about the content of an image, screenshot, or visual data. IMPORTANT: when the user sends image attachments (their message contains lines like '[Image attached at: media/xxx.jpg]'), pass those relative paths (e.g. media/20260815_1325_86a3ed28.jpg) as image_url — the app resolves them to local files automatically. Do NOT search the filesystem to locate the images. When the user's message combines text with images, ALWAYS pass that text (the user's question/instruction) as the prompt parameter so the vision model sees it.",
  "parameters": {
    "type": "object",
    "properties": {
      "image_url": {
        "type": "array",
        "items": { "type": "string" },
        "maxItems": 4,
        "description": "Image URLs/paths to analyze (up to 4 — the local vision model reliably handles at most 4 images per call; split larger batches across multiple calls). Accepts http/https URLs, data: base64 data URLs, or relative paths from image attachment messages (e.g. media/xxx.jpg — the app resolves them automatically)."
      },
      "prompt": {
        "type": "string",
        "description": "OPTIONAL. Compose a clear recognition instruction/question yourself based on the user's intent — express in your own words what the user wants to know from the image(s). Do NOT copy the user's message verbatim. Example: user sent an image + '看看这个', you write '描述图片内容并提取其中的文字信息'. Default: '描述这张图片'."
      }
    },
    "required": ["image_url"]
  },
  "emoji": "👁️",
  "supportsProvider": true
}