{
  "name": "desktop_tinker_web_extract",
  "description": "Extract content from specific web pages using available extraction backend. Returns clean page content (markdown/text) with NO LLM summarization. Pages over char_limit are head+tail truncated with an explicit footer; the full text is stored locally and the footer tells you how to read_file the omitted middle.",
  "parameters": {
    "type": "object",
    "properties": {
      "urls": { "type": "array", "description": "URL strings or search-result objects containing a string url or href field", "items": { "type": "string" } },
      "format": { "type": "string", "description": "Desired output format (\"markdown\" or \"html\", optional)", "enum": ["markdown", "html"] },
      "char_limit": { "type": "integer", "description": "Per-page char budget sent to the model (default: 15000). Larger pages truncate.", "default": 15000 }
    },
    "required": ["urls"]
  },
  "toolType": "desktop",
  "emoji": "📰"
}
