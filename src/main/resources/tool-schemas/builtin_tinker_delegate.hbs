{
  "name": "builtin_tinker_delegate",
  "description": "Spawn a child agent to handle a subtask in an isolated context, then return its final result as JSON. Use when a task is self-contained and would flood your own context with intermediate data, or for independent parallel workstreams. The child agent runs with its own ephemeral system prompt (your persona + the delegated task context), does NOT load memory, and cannot delegate further (depth limit 1).",
  "parameters": {
    "type": "object",
    "properties": {
      "goal": {
        "type": "string",
        "description": "What the child agent should accomplish. Be specific and self-contained — the child knows nothing about this conversation."
      },
      "context": {
        "type": "string",
        "description": "Background information the child agent needs: file paths, error messages, project structure, constraints."
      },
      "tasks": {
        "type": "array",
        "description": "Batch mode: tasks to run sequentially. Each item: {goal, context}. When provided, overrides top-level goal.",
        "items": {
          "type": "object",
          "properties": {
            "goal": { "type": "string", "description": "Task goal." },
            "context": { "type": "string", "description": "Task-specific context." }
          },
          "required": ["goal"]
        }
      }
    },
    "required": ["goal"]
  },
  "emoji": "🤖"
}
