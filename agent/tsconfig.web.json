{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./out",
    "composite": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/defines/**/*",
    "src/api/**/*",
    "src/services/**/*",
    "src/stores/**/*",
    "src/tools/ui/**/*"
  ],
  "exclude": ["out/"]
}
